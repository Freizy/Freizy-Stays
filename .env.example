# ── Supabase (shared Postgres + Auth + Storage) ──
# Project URL + keys: Supabase dashboard > Project Settings > API.
# - SUPABASE_ANON_KEY = publishable key (sb_publishable_...), also usable as SUPABASE_KEY
# - SUPABASE_SERVICE_ROLE_KEY = secret key (sb_secret_...), server only, never expose
# Database URLs: Supabase dashboard > Database > Connection string.
# - DATABASE_URL = Transaction pooler (port 6543, ends with ?pgbouncer=true) — server runtime
# - DIRECT_URL   = Session pooler (port 5432 on the SAME pooler host) — migrations / db push.
#   Use the session pooler, NOT the direct db.<ref> host: the direct host is
#   IPv6-only and unreachable from most Ghanaian/IPv4-only networks (P1001).
# Replace [YOUR-PASSWORD] with your database password (URL-encode special chars,
# e.g. @ -> %40). Forgot it? Database settings > Reset database password.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xyzcompany.supabase.co:5432/postgres

# ── Server ──
PORT=4000
NODE_ENV=development
# Fallback JWT for custom claims / service-to-service (Supabase Auth is primary)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Payments (sandbox first) ──
MTN_MOMO_API_KEY=
MTN_MOMO_USER_ID=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=http://localhost:4000/api/payments/webhook/momo
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_CALLBACK_URL=http://localhost:4000/api/payments/webhook/paystack

# ── Media ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Mobile (Expo public vars, prefix EXPO_PUBLIC_) ──
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
